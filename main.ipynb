# Try improve model with the best parameters

To achieve optimal balance between recall and overall accuracy, we implemented comprehensive hyperparameter tuning:

- **n_estimators**: Increased from 200 to 300 trees for better pattern learning
- **learning_rate**: Reduced from 0.05 to 0.03 for slower, more precise gradient descent
- **max_depth**: Increased from 6 to 7 to capture deeper feature interactions

- **gamma**: Added 0.1 minimum loss reduction for splits
- **reg_alpha**: L1 regularization (0.1) for feature sparsity
- **reg_lambda**: L2 regularization (1.0) for weight penalty
- **subsample**: Set to 0.85 (using 85% of data per tree)
- **colsample_bytree**: Set to 0.85 (using 85% of features per tree)

- **scale_pos_weight**: Fine-tuned from 10 to 6 for better precision-recall trade-off

import xgboost as xgb
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix, roc_auc_score, roc_curve
from sklearn.model_selection import cross_val_score
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

model = xgb.XGBClassifier(
    n_estimators=300,          
    learning_rate=0.03,        
    max_depth=7,               
    min_child_weight=1,
    subsample=0.85,            
    colsample_bytree=0.85,     
    gamma=0.1,                 
    reg_alpha=0.1,             
    reg_lambda=1,              
    scale_pos_weight=6,         
    random_state=42,
    eval_metric='logloss'
)



eval_set = [(X_test, y_test)]
model.fit(
    X_train_res, y_train_res,
    eval_set=eval_set,
    verbose=False
)


y_pred = model.predict(X_test)
y_pred_proba = model.predict_proba(X_test)[:, 1]

accuracy = accuracy_score(y_test, y_pred)
roc_auc = roc_auc_score(y_test, y_pred_proba)

print("\n" + "="*60)
print(" Result: ")
print("="*60)
print(f" (Accuracy): {accuracy:.2%}")
print(f" ROC-AUC Score: {roc_auc:.3f}")
print("="*60)
print("\n Report: ")
print(classification_report(y_test, y_pred, target_names=['healthy', 'paitent']))

cv_scores = cross_val_score(model, X_train_res, y_train_res, cv=5, scoring='recall')
print(f" Mean Recall in CV: {cv_scores.mean():.2%} (±{cv_scores.std():.2%})")

